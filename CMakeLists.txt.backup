cmake_minimum_required(VERSION 3.15)

# Project name and version
project(OSMP VERSION 1.0.0 LANGUAGES CXX)

# Set C++ standard
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

# Export compile commands for IDEs
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)

# Option to build shared libraries
option(BUILD_SHARED_LIBS "Build shared libraries" OFF)

# ============================================
# Find Packages
# ============================================
# Find wxWidgets
find_package(wxWidgets REQUIRED COMPONENTS net core base)
include(${wxWidgets_USE_FILE})

# ============================================
# Source Files
# ============================================
set(SOURCES
    src/main.cpp
    # src/fileHandling.cpp
)

set(HEADERS
    # Add your header files here
)

# ============================================
# Executable
# ============================================
if(WIN32)
    set(APP_TYPE WIN32)
else()
    set(APP_TYPE "")
endif()

add_executable(${PROJECT_NAME} ${APP_TYPE} ${SOURCES} ${HEADERS})

# Include directories
target_include_directories(${PROJECT_NAME} 
    PUBLIC
        $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>
        $<INSTALL_INTERFACE:include>
    PRIVATE
        ${CMAKE_CURRENT_SOURCE_DIR}/src
)

# ============================================
# Custom Library Paths
# ============================================
set(CUSTOM_LIBRARY_DIRS
    ${CMAKE_CURRENT_SOURCE_DIR}/include/toml++
)

set(CUSTOM_INCLUDE_DIRS)

if(CUSTOM_LIBRARY_DIRS)
    link_directories(${CUSTOM_LIBRARY_DIRS})
endif()

if(CUSTOM_INCLUDE_DIRS)
    target_include_directories(${PROJECT_NAME} PRIVATE ${CUSTOM_INCLUDE_DIRS})
endif()

# ============================================
# Link Libraries
# ============================================
set(CUSTOM_LIBRARIES) # Add other libs here if needed

# Link wxWidgets and custom libraries (Note: No comma used here)
target_link_libraries(${PROJECT_NAME} PRIVATE ${wxWidgets_LIBRARIES} ${CUSTOM_LIBRARIES})

# ============================================
# Platform-Specific Settings
# ============================================
if(WIN32)
    target_compile_definitions(${PROJECT_NAME} PRIVATE PLATFORM_WINDOWS)
    # If using Win32 GUI (prevents console window from popping up)
    # set_target_properties(${PROJECT_NAME} PROPERTIES WIN32_EXECUTABLE YES)
elseif(APPLE)
    target_compile_definitions(${PROJECT_NAME} PRIVATE PLATFORM_MACOS)
elseif(UNIX)
    target_compile_definitions(${PROJECT_NAME} PRIVATE PLATFORM_LINUX)
endif()

# ============================================
# Compiler Warnings
# ============================================
if(MSVC)
    target_compile_options(${PROJECT_NAME} PRIVATE /W4)
else()
    target_compile_options(${PROJECT_NAME} PRIVATE -Wall -Wextra -Wpedantic)
endif()

# ============================================
# Build Type Configuration
# ============================================
if(NOT CMAKE_BUILD_TYPE)
    set(CMAKE_BUILD_TYPE Release)
endif()

if(CMAKE_BUILD_TYPE STREQUAL "Debug")
    target_compile_definitions(${PROJECT_NAME} PRIVATE DEBUG_BUILD)
else()
    target_compile_definitions(${PROJECT_NAME} PRIVATE RELEASE_BUILD)
endif()

# ============================================
# Installation
# ============================================
install(TARGETS ${PROJECT_NAME}
    RUNTIME DESTINATION bin
    LIBRARY DESTINATION lib
    ARCHIVE DESTINATION lib
)

# ============================================
# Automatic DLL Copy (Windows Only)
# ============================================
if(WIN32)
    # 1. Define where your wxWidgets DLLs are located. 
    # Based on your error, they are here:
    set(WX_DLL_DIR "C:/wxWidgets/lib/vc14x_x64_dll")

    # 2. Copy the DLLs to the folder where your .exe is built
    add_custom_command(TARGET ${PROJECT_NAME} POST_BUILD
        COMMAND ${CMAKE_COMMAND} -E copy_directory
        "${WX_DLL_DIR}"
        "$<TARGET_FILE_DIR:${PROJECT_NAME}>"
        COMMENT "Copying wxWidgets DLLs from ${WX_DLL_DIR} to output directory..."
    )
endif()

# ============================================
# Print Configuration Summary
# ============================================
message(STATUS "")
message(STATUS "Configuration Summary:")
message(STATUS "  Project: ${PROJECT_NAME} v${PROJECT_VERSION}")
message(STATUS "  Build Type: ${CMAKE_BUILD_TYPE}")
message(STATUS "  wxWidgets LIBRARIES: ${wxWidgets_LIBRARIES}")
message(STATUS "  Platform: ${CMAKE_SYSTEM_NAME}")
message(STATUS "")